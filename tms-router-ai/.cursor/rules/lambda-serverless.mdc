### 핵심 Chalice 앱 패턴
```python
# app.py
import json
import logging
from chalice import Chalice, Response
from typing import Dict, Any

from src.infrastructure.ai.langchain_service import LangChainAIService
from src.use_cases.optimize_route_use_case import OptimizeRouteUseCase
from src.presentation.request_validators import validate_tms_request
from src.shared.exceptions import ValidationError, AIServiceError

app = Chalice(app_name='tms-router-ai')
app.debug = True

# 로깅 설정
logger = logging.getLogger()
logger.setLevel(logging.INFO)

# 글로벌 객체 초기화 (Cold Start 최적화)
ai_service = None
route_optimizer = None

def get_ai_service():
    """AI 서비스 싱글톤 패턴"""
    global ai_service
    if ai_service is None:
        ai_service = LangChainAIService()
    return ai_service

def get_route_optimizer():
    """경로 최적화 Use Case 싱글톤 패턴"""
    global route_optimizer
    if route_optimizer is None:
        route_optimizer = OptimizeRouteUseCase(get_ai_service())
    return route_optimizer

@app.route('/optimize-route', methods=['POST'])
def optimize_route():
    """TMS 배차 최적화 API 엔드포인트"""
    try:
        # 1. 요청 데이터 가져오기
        request_data = app.current_request.json_body
        
        # 2. 파라미터 검증
        tms_request = validate_tms_request(request_data)
        
        # 3. 배차 최적화 실행
        optimizer = get_route_optimizer()
        result = optimizer.execute(tms_request)
        
        # 4. 성공 응답
        return {
            'status': 'success',
            'data': result.to_dict()
        }
        
    except ValidationError as e:
        logger.error(f"Validation error: {e}")
        return Response(
            body={'error': f'Invalid parameters: {str(e)}'},
            status_code=400,
            headers={'Content-Type': 'application/json'}
        )
    except AIServiceError as e:
        logger.error(f"AI service error: {e}")
        return Response(
            body={'error': f'AI service error: {str(e)}'},
            status_code=500,
            headers={'Content-Type': 'application/json'}
        )
    except Exception as e:
        logger.error(f"Unexpected error: {e}")
        return Response(
            body={'error': 'Internal server error'},
            status_code=500,
            headers={'Content-Type': 'application/json'}
        )

@app.route('/health', methods=['GET'])
def health_check():
    """헬스 체크 엔드포인트"""
    return {'status': 'healthy', 'service': 'tms-router-ai'}

@app.route('/feedback', methods=['POST'])
def submit_feedback():
    """AI 배차 결과에 대한 피드백 제출"""
    try:
        feedback_data = app.current_request.json_body
        # 피드백 처리 로직
        return {'status': 'feedback_received'}
    except Exception as e:
        logger.error(f"Feedback error: {e}")
        return Response(
            body={'error': 'Failed to process feedback'},
            status_code=500
        )
```

