# TMS Router Hybrid - 환경변수 설정 템플릿
# 이 파일을 .env로 복사한 후 실제 값으로 수정하세요
# cp .env.example .env

# =============================================================================
# 외부 API 키 설정 (필수)
# =============================================================================

# OpenWeatherMap API 키
# 발급: https://openweathermap.org/api
# 무료 플랜: 1,000 calls/day
OPENWEATHER_API_KEY=your_openweather_api_key_here

# HERE Maps API 키  
# 발급: https://developer.here.com/
# 무료 플랜: 250,000 requests/month
HERE_API_KEY=your_here_api_key_here

# 카카오맵 REST API 키
# 발급: https://developers.kakao.com/
# 무료 플랜: 300,000 calls/day
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# =============================================================================
# 데이터베이스 설정 (MySQL)
# =============================================================================

# MySQL 연결 설정
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=tms_db
MYSQL_USER=tms_user
MYSQL_PASSWORD=tms_password

# SQLAlchemy 설정
MYSQL_ECHO_SQL=false

# =============================================================================
# 애플리케이션 기본 설정
# =============================================================================

# 디버그 모드 (true/false)
TMS_DEBUG=false

# 로그 레벨 (DEBUG/INFO/WARNING/ERROR/CRITICAL)
TMS_LOG_LEVEL=INFO

# 로그 파일 경로 (선택사항, 설정하지 않으면 콘솔 출력)
# TMS_LOG_FILE=./logs/tms.log

# =============================================================================
# 캐시 설정
# =============================================================================

# 캐시 디렉토리
TMS_CACHE__CACHE_DIR=./cache

# 메모리 캐시 크기 (MB)
TMS_CACHE__MEMORY_SIZE_MB=100

# 캐시 TTL 설정 (분)
TMS_CACHE__WEATHER_CACHE_TTL=30
TMS_CACHE__TRAFFIC_CACHE_TTL=15
TMS_CACHE__ROUTING_CACHE_TTL=60

# 자동 캐시 정리 활성화
TMS_CACHE__AUTO_CLEANUP_ENABLED=true
TMS_CACHE__CLEANUP_INTERVAL_HOURS=6

# =============================================================================
# 외부 API 상세 설정
# =============================================================================

# API 타임아웃 설정 (초)
TMS_EXTERNAL_API__OPENWEATHER_TIMEOUT=10
TMS_EXTERNAL_API__HERE_TIMEOUT=15
TMS_EXTERNAL_API__KAKAO_TIMEOUT=10

# 동시 요청 수 제한
TMS_EXTERNAL_API__MAX_CONCURRENT_REQUESTS=10
TMS_EXTERNAL_API__REQUESTS_PER_SECOND=5

# =============================================================================
# 알고리즘 설정
# =============================================================================

# 알고리즘 선택 임계값 (주문 수 기준)
TMS_ALGORITHM__SMALL_ORDER_THRESHOLD=30
TMS_ALGORITHM__MEDIUM_ORDER_THRESHOLD=100
TMS_ALGORITHM__LARGE_ORDER_THRESHOLD=300

# 알고리즘 시간 제한 (초)
TMS_ALGORITHM__NEAREST_NEIGHBOR_TIME_LIMIT=30
TMS_ALGORITHM__GENETIC_ALGORITHM_TIME_LIMIT=300
TMS_ALGORITHM__SIMULATED_ANNEALING_TIME_LIMIT=600

# 품질 임계값 (0.0-1.0)
TMS_ALGORITHM__QUALITY_THRESHOLD=0.8

# 조기 종료 활성화
TMS_ALGORITHM__EARLY_STOPPING_ENABLED=true

# =============================================================================
# 차량 설정
# =============================================================================

# 기본 차량 용량
TMS_VEHICLE__DEFAULT_MAX_CAPACITY=40
TMS_VEHICLE__DEFAULT_SAFE_CAPACITY=35

# 경험도별 계수 (소수점)
# TMS_VEHICLE__EXPERIENCE_MULTIPLIERS__BEGINNER=0.70
# TMS_VEHICLE__EXPERIENCE_MULTIPLIERS__JUNIOR=0.85
# TMS_VEHICLE__EXPERIENCE_MULTIPLIERS__INTERMEDIATE=1.00
# TMS_VEHICLE__EXPERIENCE_MULTIPLIERS__SENIOR=1.15
# TMS_VEHICLE__EXPERIENCE_MULTIPLIERS__EXPERT=1.30

# =============================================================================
# 날씨 조건 설정
# =============================================================================

# 날씨별 영향 계수 (소수점)
# TMS_WEATHER__WEATHER_MULTIPLIERS__CLEAR=1.1
# TMS_WEATHER__WEATHER_MULTIPLIERS__CLOUDS=1.0
# TMS_WEATHER__WEATHER_MULTIPLIERS__RAIN=0.8
# TMS_WEATHER__WEATHER_MULTIPLIERS__HEAVY_RAIN=0.6
# TMS_WEATHER__WEATHER_MULTIPLIERS__SNOW=0.5
# TMS_WEATHER__WEATHER_MULTIPLIERS__STORM=0.3

# 심각도 임계값 (1.0-5.0)
# TMS_WEATHER__SEVERITY_THRESHOLDS__GOOD=1.5
# TMS_WEATHER__SEVERITY_THRESHOLDS__FAIR=2.5
# TMS_WEATHER__SEVERITY_THRESHOLDS__POOR=3.5
# TMS_WEATHER__SEVERITY_THRESHOLDS__BAD=4.5
# TMS_WEATHER__SEVERITY_THRESHOLDS__SEVERE=5.0

# =============================================================================
# 교통 조건 설정
# =============================================================================

# 정체도별 영향 계수 (소수점)
# TMS_TRAFFIC__CONGESTION_MULTIPLIERS__FREE_FLOW=1.1
# TMS_TRAFFIC__CONGESTION_MULTIPLIERS__NORMAL=1.0
# TMS_TRAFFIC__CONGESTION_MULTIPLIERS__CONGESTED=0.8
# TMS_TRAFFIC__CONGESTION_MULTIPLIERS__HEAVY=0.6

# 정체 수준 임계값 (0.0-1.0)
# TMS_TRAFFIC__CONGESTION_THRESHOLDS__FREE_FLOW=0.2
# TMS_TRAFFIC__CONGESTION_THRESHOLDS__NORMAL=0.6
# TMS_TRAFFIC__CONGESTION_THRESHOLDS__CONGESTED=0.8
# TMS_TRAFFIC__CONGESTION_THRESHOLDS__HEAVY=1.0

# =============================================================================
# 개발 및 테스트 설정
# =============================================================================

# 테스트 환경 여부
# TMS_TESTING=false

# 샘플 데이터 사용 (데이터베이스가 없을 때)
# TMS_USE_SAMPLE_DATA=true

# 성능 프로파일링 활성화
# TMS_ENABLE_PROFILING=false

# =============================================================================
# 설정 예시 및 도움말
# =============================================================================

# 프로덕션 환경 예시:
# TMS_DEBUG=false
# TMS_LOG_LEVEL=WARNING
# TMS_CACHE__MEMORY_SIZE_MB=500
# TMS_EXTERNAL_API__MAX_CONCURRENT_REQUESTS=20

# 개발 환경 예시:
# TMS_DEBUG=true
# TMS_LOG_LEVEL=DEBUG
# TMS_CACHE__MEMORY_SIZE_MB=50
# TMS_LOG_FILE=./logs/debug.log

# 테스트 환경 예시:
# TMS_DEBUG=true
# TMS_LOG_LEVEL=DEBUG
# TMS_CACHE__MEMORY_SIZE_MB=10
# TMS_TESTING=true
# TMS_USE_SAMPLE_DATA=true

# =============================================================================
# 보안 주의사항
# =============================================================================
# 
# 1. 이 파일을 .gitignore에 추가하여 git에 커밋되지 않도록 하세요
# 2. API 키는 절대 공개 저장소에 노출하지 마세요
# 3. 프로덕션 환경에서는 환경변수를 직접 설정하는 것을 권장합니다
# 4. 정기적으로 API 키를 교체하세요